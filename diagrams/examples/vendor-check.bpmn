<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_vendor-check" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="vendor-check" name="Vendor check" isExecutable="false">
    <bpmn:startEvent id="Start" name="Vendor named on invoice">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Lookup" name="Look up vendor master data">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Known" name="Known vendor?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Iban" name="Validate IBAN">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Onboarding" name="Vendor onboarding" calledElement="vendor-onboarding">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Join" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Vendor verified">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Lookup" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Lookup" targetRef="Known" />
    <bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Known" targetRef="Iban" />
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Known" targetRef="Onboarding" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Iban" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Onboarding" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Join" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="vendor-check">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="42" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="15" y="202" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lookup_di" bpmnElement="Lookup">
        <dc:Bounds x="180" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Known_di" bpmnElement="Known" isMarkerVisible="true">
        <dc:Bounds x="375" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Iban_di" bpmnElement="Iban">
        <dc:Bounds x="520" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Onboarding_di" bpmnElement="Onboarding">
        <dc:Bounds x="520" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join" isMarkerVisible="true">
        <dc:Bounds x="715" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="892" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="865" y="202" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="78" y="180" />
        <di:waypoint x="180" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="280" y="180" />
        <di:waypoint x="375" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="400" y="155" />
        <di:waypoint x="400" y="60" />
        <di:waypoint x="520" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="400" y="205" />
        <di:waypoint x="400" y="300" />
        <di:waypoint x="520" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="620" y="60" />
        <di:waypoint x="740" y="60" />
        <di:waypoint x="740" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="620" y="300" />
        <di:waypoint x="740" y="300" />
        <di:waypoint x="740" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="765" y="180" />
        <di:waypoint x="892" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
