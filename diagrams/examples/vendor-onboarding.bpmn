<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_vendor-onboarding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="vendor-onboarding" name="Vendor onboarding" isExecutable="false">
    <bpmn:startEvent id="Start" name="Unknown vendor">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Docs" name="Collect vendor documents">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Screen" name="Screen against sanctions list">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Clear" name="Screening clear?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create" name="Create vendor record">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Reject" name="Reject and notify requester">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndOk" name="Vendor created">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndNo" name="Vendor rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Docs" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Docs" targetRef="Screen" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Screen" targetRef="Clear" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Clear" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Clear" targetRef="Reject" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Create" targetRef="EndOk" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Reject" targetRef="EndNo" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="vendor-onboarding">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="42" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="15" y="202" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Docs_di" bpmnElement="Docs">
        <dc:Bounds x="180" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Screen_di" bpmnElement="Screen">
        <dc:Bounds x="350" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clear_di" bpmnElement="Clear" isMarkerVisible="true">
        <dc:Bounds x="545" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Create_di" bpmnElement="Create">
        <dc:Bounds x="690" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="690" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndOk_di" bpmnElement="EndOk">
        <dc:Bounds x="892" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="865" y="82" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndNo_di" bpmnElement="EndNo">
        <dc:Bounds x="892" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="865" y="322" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="78" y="180" />
        <di:waypoint x="180" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="280" y="180" />
        <di:waypoint x="350" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="450" y="180" />
        <di:waypoint x="545" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="570" y="155" />
        <di:waypoint x="570" y="60" />
        <di:waypoint x="690" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="570" y="205" />
        <di:waypoint x="570" y="300" />
        <di:waypoint x="690" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="790" y="60" />
        <di:waypoint x="892" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="790" y="300" />
        <di:waypoint x="892" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
